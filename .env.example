# =============================================================================
# QIMA × Honeylang — Tableau de bord financier
# Modèle de configuration. Copier vers `.env.local` puis renseigner.
#
#   cp .env.example .env.local
#
# ⚠️  NE JAMAIS committer `.env.local` ni aucune valeur réelle.
# ⚠️  Aucune de ces variables ne doit être préfixée `NEXT_PUBLIC_` :
#     elles sont toutes strictement serveur.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SESSION & AUTHENTIFICATION  (obligatoire)
# -----------------------------------------------------------------------------

# Clé de signature des jetons de session (HMAC-SHA256).
# Générer une valeur aléatoire d'au moins 32 caractères :
#     openssl rand -base64 32
# L'application REFUSE de démarrer si cette clé est absente ou trop courte.
SESSION_SECRET=remplacer-par-32-caracteres-aleatoires-minimum

# Alias historique de SESSION_SECRET, accepté pour compatibilité avec le
# déploiement Netlify existant. Si les deux sont définis, SESSION_SECRET gagne.
# À supprimer une fois SESSION_SECRET configuré côté hébergeur.
# NEXTAUTH_SECRET=

# Liste blanche des adresses autorisées, séparées par des virgules.
# La comparaison est insensible à la casse et aux espaces.
ALLOWED_EMAILS=prenom.nom@exemple.fr,autre.personne@exemple.fr

# Mot de passe partagé du tableau de bord.
# Minimum 12 caractères. L'application REFUSE de démarrer en dessous.
DASHBOARD_PASSWORD=remplacer-par-un-mot-de-passe-long-et-unique

# Durée de vie d'une session, en heures. Défaut : 12.
# AUTH_SESSION_MAX_AGE_HOURS=12

# Origine publique canonique, utilisée pour valider les redirections
# et l'en-tête Origin des requêtes mutatives (protection CSRF).
# En production Netlify, renseigner l'URL exacte du site.
# APP_ORIGIN=https://exemple.netlify.app


# -----------------------------------------------------------------------------
# 2. GOOGLE DRIVE — OAuth 2.0, lecture seule  (obligatoire)
# -----------------------------------------------------------------------------
# Modèle retenu : OAuth 2.0 « Web server » avec un compte Google dédié et un
# refresh token stocké côté serveur. Voir docs/GOOGLE_DRIVE.md pour la
# procédure d'autorisation complète et la justification de ce choix.
#
# Le scope est fixé à l'autorisation, PAS à l'exécution :
#     https://www.googleapis.com/auth/drive.readonly
# Un refresh token émis avec un scope plus large doit être RÉVOQUÉ puis
# ré-émis via `npm run drive:authorize`.

GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-client-secret
GOOGLE_REFRESH_TOKEN=votre-refresh-token

# Identifiants des trois classeurs sources.
# L'ID est le segment de l'URL Drive : /file/d/<ID>/view
DRIVE_FILE_ID_PILOTAGE=id-du-fichier-Honeylang_PF_v3
DRIVE_FILE_ID_CRC=id-du-fichier-QIMA_Honeylang_Fiches_CRC_v5
DRIVE_FILE_ID_KPI=id-du-fichier-Honeylang_KPI_DTC_v1


# -----------------------------------------------------------------------------
# 3. RÉGLAGES DRIVE  (optionnel — valeurs par défaut sûres)
# -----------------------------------------------------------------------------

# Délai maximal d'une requête Drive, en millisecondes. Défaut : 20000.
# DRIVE_TIMEOUT_MS=20000

# Taille maximale acceptée par classeur, en octets. Défaut : 26214400 (25 Mio).
# Un fichier plus volumineux est rejeté sans être téléchargé.
# DRIVE_MAX_FILE_BYTES=26214400

# Durée de vie du cache serveur des données parsées, en secondes. Défaut : 900.
# Ce cache est strictement côté serveur et n'est jamais exposé au CDN.
# DATA_CACHE_TTL_SECONDS=900


# -----------------------------------------------------------------------------
# 4. DÉVELOPPEMENT LOCAL  (optionnel — jamais en production)
# -----------------------------------------------------------------------------

# Lit les classeurs depuis des fixtures locales synthétiques au lieu de Drive.
# Permet de travailler sans credentials Google. Ignoré si NODE_ENV=production.
#     DATA_SOURCE=local   → fixtures de tests/fixtures/
#     DATA_SOURCE=drive   → Google Drive (défaut)
# DATA_SOURCE=local

# Contourne l'écran de connexion : le tableau de bord s'ouvre directement.
# Pratique pour parcourir l'interface sans manipuler d'identifiants.
#
# ⚠️ Trois verrous rendent ce réglage inopérant en production :
#    1. ignoré dès que NODE_ENV=production (ce que `next build`/`next start` imposent) ;
#    2. la valeur doit être exactement « true » — ni « 1 », ni « yes », ni « TRUE » ;
#    3. relue à chaque requête, jamais mise en cache.
# Un bandeau rouge permanent signale l'état actif sur chaque écran.
# AUTH_DISABLED=true


# -----------------------------------------------------------------------------
# VARIABLES SUPPRIMÉES — ne plus utiliser
# -----------------------------------------------------------------------------
# NEXTAUTH_URL            NextAuth n'est pas utilisé. Remplacé par APP_ORIGIN.
# RESEND_API_KEY          L'authentification par magic link a été retirée.
# EMAIL_SERVER_HOST       idem
# EMAIL_SERVER_PORT       idem
# EMAIL_SERVER_USER       idem
# EMAIL_SERVER_PASSWORD   idem
# EMAIL_FROM              idem
# -----------------------------------------------------------------------------
