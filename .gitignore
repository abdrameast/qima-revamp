.env
.env.*
!.env.example
*.local.txt
.secrets-to-rotate.local.txt
env-config.txt
env-variables.txt
*.pem
*.p12
*-service-account*.json
gcp-*.json

# base locale héritée (Prisma/NextAuth non utilisés)
*.db
*.sqlite
*.sqlite3

# tests
/coverage
/test-results

# fixtures synthétiques régénérables
/tests/fixtures/generated/


# réglages locaux de l'éditeur
/.claude/
